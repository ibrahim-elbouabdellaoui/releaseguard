 /**
  * UserService — manages user account lookups and profile data.
  * Used by OrderService, PaymentService, and the /users API handler.
  */
 
 /**
  * @typedef {Object} UserProfile
  * @property {string} id
  * @property {string} email
  * @property {string} name
  * @property {"standard" | "premium" | "enterprise"} tier
  * @property {boolean} active
+ * @property {string} [lastLoginAt]
+ * @property {number} [orderCount]
  */
 
@@ -18,16 +20,22 @@ const userStore = new Map([
 /**
  * Retrieves a user profile by ID.
- * Returns null if the user does not exist.
+ * Returns an enriched user profile object including derived fields.
+ * BREAKING: response shape has changed — callers that destructure only
+ * { id, email, name, tier, active } will now receive additional fields.
  *
  * @param {string} userId
- * @returns {{ id: string, email: string, name: string, tier: string, active: boolean } | null}
+ * @returns {{ id: string, email: string, name: string, tier: string, active: boolean, lastLoginAt: string, orderCount: number } | null}
  */
 function getUser(userId) {
   const user = userStore.get(userId);
-  return user ?? null;
+  if (!user) return null;
+  // Enrich with derived fields
+  return {
+    ...user,
+    lastLoginAt: new Date(Date.now() - Math.random() * 7 * 24 * 3600 * 1000).toISOString(),
+    orderCount: Math.floor(Math.random() * 50),
+  };
 }
 
